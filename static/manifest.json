{
  "manifest_version": 3,
  "name": "WIT-Calendar",
  "version": "5.1.0",
  "description": "A Chrome extension to import WIT classes into your calendar!",
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://selfservice.wit.edu/StudentRegistrationSsb/ssb/registrationHistory/registrationHistory",
        "https://selfservice.wit.edu/StudentRegistrationSsb/ssb/registrationHistory/registrationHistory",
        "https://selfservice.wit.edu/StudentRegistrationSsb/ssb/registrationHistory/reset?term=",
        "https://selfservice.wit.edu/StudentRegistrationSsb/ssb/classRegistration/getRegistrationEvents?termFilter=",
        "https://selfservice.wit.edu/BannerGeneralSsb/ssb/PersonalInformationDetails/getEmails"
      ],
      "js": [
        "scripts/init.js"
      ]
    },
    {
      "matches": [
        "https://*.witcc.dev/*",
        "http://localhost/*"
      ],
      "js": [
        "scripts/site.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "activeTab",
    "tabs",
    "storage",
    "identity",
    "identity.email"
  ],
  "icons": {
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://selfservice.wit.edu/*",
    "https://*.witcc.dev/*",
    "https://heron-selected-literally.ngrok-free.app/*",
    "http://localhost/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wit-calendar@witcc.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["personallyIdentifyingInfo", "authenticationInfo", "websiteContent"],
        "optional": ["technicalAndInteraction"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}